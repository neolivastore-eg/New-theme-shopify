<div class="atelier-block atelier-block--heading atelier-align--{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
  {% if block.settings.eyebrow != blank %}<p class="atelier-eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
  {% if block.settings.heading != blank %}
    {% if block.settings.level == 'h3' %}<h3 class="atelier-title atelier-title--{{ block.settings.size }}">{{ block.settings.heading | escape }}</h3>
    {% else %}<h2 class="atelier-title atelier-title--{{ block.settings.size }}">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% endif %}
</div>
{% schema %}
{
  "name": "Atelier heading",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beauty, considered." },
    { "type": "select", "id": "level", "label": "Heading level", "default": "h2", "options": [
      { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }
    ] },
    { "type": "select", "id": "size", "label": "Size", "default": "large", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }
    ] },
    { "type": "select", "id": "alignment", "label": "Align text", "default": "start", "options": [
      { "value": "start", "label": "Start" }, { "value": "center", "label": "Center" }
    ] }
  ],
  "presets": [ { "name": "Atelier heading" } ]
}
{% endschema %}
