{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">
  {% if paginate.previous %}<a href="{{ paginate.previous.url }}">{{ 'pagination.previous' | t }}</a>{% endif %}
  <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
  {% if paginate.next %}<a href="{{ paginate.next.url }}">{{ 'pagination.next' | t }}</a>{% endif %}
</nav>{% endif %}
