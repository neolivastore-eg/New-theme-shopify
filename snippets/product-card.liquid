<a class="product-card" href="{{ card_product.url }}">
  {% if card_product.featured_image != blank %}
    {{ card_product.featured_image | image_url: width: 900 | image_tag: widths: '250,400,600,900', sizes: '(max-width:720px) 50vw, 25vw', loading: 'lazy', class: 'product-card__image' }}
  {% else %}<div class="product-card__image" aria-hidden="true"></div>{% endif %}
  <div class="product-card__meta">
    {% if card_product.vendor != blank %}<div class="product-card__vendor">{{ card_product.vendor | escape }}</div>{% endif %}
    <div class="product-card__title">{{ card_product.title | escape }}</div>
    {% unless card_product.available %}<p class="product-card__availability">{{ 'products.sold_out' | t }}</p>{% endunless %}
    <div class="product-card__price">
      {% if card_product.price_varies %}{{ 'products.from_price' | t }} {% endif %}{{ card_product.price | money }}
      {% unless card_product.price_varies %}{% if card_product.compare_at_price > card_product.price %}
        <s class="product-card__compare">{{ card_product.compare_at_price | money }}</s>
      {% endif %}{% endunless %}
    </div>
  </div>
</a>
