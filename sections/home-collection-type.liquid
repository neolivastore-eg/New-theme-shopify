<section class="nv-type-collections nv-surface--{{ section.settings.surface }} section-space" id="HomeTypeCollections-{{ section.id }}">
  <div class="site-width nv-type-collections__inner">
    {% if section.settings.eyebrow != blank %}<p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="nv-type-collections__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    <nav class="nv-type-collections__links" aria-label="{{ section.settings.heading | default: 'Beauty collections' | escape }}">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          <a href="{{ block.settings.collection.url }}" class="nv-type-collections__link" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label | default: block.settings.collection.title | escape }}</span>
            <span class="nv-type-collections__arrow" aria-hidden="true">↗</span>
          </a>
        {% elsif request.design_mode %}
          <span class="nv-type-collections__link" {{ block.shopify_attributes }}>Select a collection</span>
        {% endif %}
      {% endfor %}
    </nav>
  </div>
</section>
{% schema %}
{
 "name":"Typographic collections",
 "settings":[
  {"type":"select","id":"surface","label":"Background","options":[{"value":"white","label":"White"},{"value":"cream","label":"Warm cream"}],"default":"white"},
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"POPULAR COLLECTIONS"},
  {"type":"text","id":"heading","label":"Heading","default":"Explore by category"}
 ],
 "blocks":[{"type":"link","name":"Collection link","settings":[
  {"type":"collection","id":"collection","label":"Collection"},
  {"type":"text","id":"label","label":"Optional shorter label"}
 ]}],
 "max_blocks":10,
 "presets":[{"name":"Typographic collections","blocks":[{"type":"link"},{"type":"link"},{"type":"link"},{"type":"link"}]}]
}
{% endschema %}
