{% liquid
  assign main_photo = section.settings.image
  if main_photo == blank and section.settings.product != blank and section.settings.product.available
    assign main_photo = section.settings.product.featured_image
  endif
  if main_photo == blank and section.settings.collection != blank
    for candidate in section.settings.collection.products limit: 20
      if candidate.available and candidate.featured_image != blank
        assign main_photo = candidate.featured_image
        break
      endif
    endfor
  endif
%}
<section class="nv-hotspots nv-surface--cream section-space" id="HomeHotspots-{{ section.id }}" data-nv-hotspots>
  <div class="site-width nv-hotspots__inner">
    {% if section.settings.eyebrow != blank %}<p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2 class="nv-serif">{{ section.settings.heading | escape }}</h2>
    <div class="nv-hotspots__stage">
      {% if main_photo != blank %}
        {{ main_photo | image_url: width: 1600 | image_tag: class: 'nv-hotspots__image', widths: '400,700,1000,1600', sizes: '(max-width: 749px) 100vw, 900px', loading: 'lazy' }}
      {% elsif request.design_mode %}
        <span class="nv-media-hint">Choose your original shoppable image or a real product photo.</span>
      {% endif %}
      {% for block in section.blocks %}
        {% assign hot_product = block.settings.product %}
        {% if hot_product != blank and hot_product.available %}
          <div class="nv-hotspots__point" style="--nv-x:{{ block.settings.x }}%;--nv-y:{{ block.settings.y }}%;" {{ block.shopify_attributes }}>
            <button type="button" class="nv-hotspots__pin" data-nv-hotspot aria-expanded="false" aria-controls="HotspotInfo-{{ section.id }}-{{ forloop.index }}" aria-label="Show {{ hot_product.title | escape }}">+</button>
            <div class="nv-hotspots__info" id="HotspotInfo-{{ section.id }}-{{ forloop.index }}" hidden>
              <a href="{{ hot_product.url }}">
                {% if hot_product.featured_image != blank %}
                  {{ hot_product.featured_image | image_url: width: 220 | image_tag: class: 'nv-hotspots__thumb', loading: 'lazy', widths: '110,220', sizes: '70px' }}
                {% endif %}
                <span><strong>{{ hot_product.title | escape }}</strong><small>{{ hot_product.price | money }}</small></span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.collection != blank %}<a class="nv-text-cta" href="{{ section.settings.collection.url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
  </div>
</section>
{% schema %}
{
 "name":"Shoppable real image",
 "settings":[
   {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE BEAUTY EDIT"},
   {"type":"text","id":"heading","label":"Heading","default":"Love Your Skin"},
   {"type":"image_picker","id":"image","label":"Your real lifestyle image"},
   {"type":"product","id":"product","label":"Fallback main product photo"},
   {"type":"collection","id":"collection","label":"Fallback collection"},
   {"type":"text","id":"button_label","label":"View all text","default":"View all products"}
 ],
 "blocks":[{"type":"pin","name":"Product hotspot","settings":[
   {"type":"product","id":"product","label":"Real product"},
   {"type":"range","id":"x","label":"Horizontal position","min":5,"max":95,"step":5,"unit":"%","default":50},
   {"type":"range","id":"y","label":"Vertical position","min":5,"max":95,"step":5,"unit":"%","default":50}
 ]}],
 "max_blocks":6,
 "presets":[{"name":"Shoppable real image"}]
}
{% endschema %}
