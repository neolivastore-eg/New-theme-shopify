{% assign current_variant = product.selected_or_first_available_variant %}
<section class="site-width section-space product-page">
  <div class="product-gallery">
    {% for media in product.media %}
      <div class="product-gallery__item">
      {% if media.media_type == 'image' %}{{ media.preview_image | image_url: width: 1400 | image_tag: widths: '360,600,900,1200,1400', loading: 'lazy' }}
      {% else %}{{ media | media_tag: image_size: '800x', controls: true }}{% endif %}
      </div>
    {% else %}<div>{{ 'products.no_image' | t }}</div>{% endfor %}
  </div>
  <div class="product-info" data-product-form-root>
    {% if product.vendor != blank %}<div class="eyebrow">{{ product.vendor | escape }}</div>{% endif %}
    <h1 class="product-info__title">{{ product.title | escape }}</h1>
    <div class="product-info__price" data-product-price>{{ current_variant.price | money }}</div>
    <div class="rte">{{ product.description }}</div>
    {% form 'product', product, class: 'product-form' %}
      {% unless product.has_only_default_variant %}
      <div class="form-field"><label for="Variants-{{ section.id }}">{{ 'products.variant' | t }}</label>
        <select id="Variants-{{ section.id }}" name="id" data-variant-selector>
          {% for variant in product.variants %}
          <option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" {% if current_variant.id == variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}</option>
          {% endfor %}
        </select>
      </div>
      {% else %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% endunless %}
      <div class="form-field"><label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"></div>
      <button class="button button--primary product-form__submit" type="submit" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</button>
    {% endform %}
    {% for block in section.blocks %}
      {% case block.type %}
      {% when 'trust_text' %}<div class="product-trust" {{ block.shopify_attributes }}>{{ block.settings.message | escape }}</div>
      {% when 'accordion' %}<details class="product-accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary>{{ block.settings.body }}</details>
      {% endcase %}
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Main product","settings":[],"blocks":[{"type":"trust_text","name":"Trust text","settings":[{"type":"text","id":"message","label":"Text","default":"Carefully curated essentials"}]},{"type":"accordion","name":"Collapsible content","settings":[{"type":"text","id":"heading","label":"Heading","default":"More details"},{"type":"richtext","id":"body","label":"Content"}]}]}
{% endschema %}
