<section class="site-width section-space contact-section" id="ContactSection-{{ section.id }}">
  <div class="page-intro">
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% endif %}
  </div>
  {% form 'contact', id: 'AtelierContactForm', class: 'contact-form' %}
    {% if form.posted_successfully? %}<p role="status">{{ 'contact.success' | t }}</p>{% endif %}
    {{ form.errors | default_errors }}
    <div class="form-field">
      <label for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
      <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}">
    </div>
    <div class="form-field">
      <label for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
      <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" required value="{{ form.email | escape }}">
    </div>
    <div class="form-field">
      <label for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
      <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}">
    </div>
    <div class="form-field">
      <label for="ContactMessage-{{ section.id }}">{{ 'contact.message' | t }}</label>
      <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea>
    </div>
    <button class="button button--primary" type="submit">{{ 'contact.send' | t }}</button>
  {% endform %}
</section>
{% schema %}
{"name":"Contact form","settings":[
{"type":"text","id":"heading","label":"Heading","default":"Get in touch"},
{"type":"richtext","id":"description","label":"Introduction","default":"<p>Tell us how we can help.</p>"}
],"presets":[{"name":"Contact form"}]}
{% endschema %}
