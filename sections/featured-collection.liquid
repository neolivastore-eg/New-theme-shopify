<section class="site-width section-space" id="FeaturedCollection-{{ section.id }}">
  <div class="section-heading"><div>
    {% if section.settings.eyebrow != blank %}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
  </div>
  {% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>{% endif %}</div>
  {% if section.settings.collection != blank %}
    <div class="product-grid">
      {% assign shown_products = 0 %}
      {% for item in section.settings.collection.products limit: 50 %}
        {% if item.available and item.featured_image != blank %}
          {% render 'product-card', card_product: item %}
          {% assign shown_products = shown_products | plus: 1 %}
          {% if shown_products >= section.settings.product_limit %}{% break %}{% endif %}
        {% endif %}
      {% endfor %}
    </div>
    {% if shown_products == 0 %}<div class="empty-state"><p>{{ 'collections.empty' | t }}</p></div>{% endif %}
  {% elsif request.design_mode %}
    <div class="empty-state"><p>Select a collection in the theme editor.</p></div>
  {% endif %}
</section>
{% schema %}
{"name":"Featured collection","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"DISCOVER"},
{"type":"text","id":"heading","label":"Heading","default":"Our edit"},
{"type":"collection","id":"collection","label":"Collection"},
{"type":"range","id":"product_limit","label":"Products","min":2,"max":12,"step":1,"default":8}
],"presets":[{"name":"Featured collection"}]}
{% endschema %}
