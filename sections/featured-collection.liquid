<section class="site-width section-space">
  <div class="section-heading"><div><div class="eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2></div>
  {% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>{% endif %}</div>
  <div class="product-grid">
    {% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.product_limit %}{% render 'product-card', card_product: product %}{% endfor %}{% endif %}
  </div>
</section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"DISCOVER"},{"type":"text","id":"heading","label":"Heading","default":"Our edit"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"product_limit","label":"Products","min":2,"max":12,"step":1,"default":8}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
