<section class="site-width section-space campaign-section" id="CampaignSection-{{ section.id }}">
  {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
    <div class="section-heading campaign-section__heading"><div>
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    {% if section.settings.view_all_label != blank and section.settings.view_all_link != blank %}
      <a class="campaign-section__all" href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_label | escape }}</a>
    {% endif %}</div>
  {% endif %}
  <div class="campaign-cards campaign-cards--{{ section.settings.columns }}">
    {% for block in section.blocks %}
      {% liquid
        assign card_collection = block.settings.collection
        assign card_image = block.settings.image
        if card_image == blank and block.settings.featured_product != blank and block.settings.featured_product.available
          assign card_image = block.settings.featured_product.featured_image
        endif
        if card_image == blank and card_collection != blank
          for candidate in card_collection.products limit: 20
            if candidate.available and candidate.featured_image != blank
              assign card_image = candidate.featured_image
              break
            endif
          endfor
        endif
        assign card_link = block.settings.link
        if card_link == blank and card_collection != blank
          assign card_link = card_collection.url
        endif
        assign card_title = block.settings.heading
        if card_title == blank and card_collection != blank
          assign card_title = card_collection.title
        endif
      %}
      <article class="campaign-card{% if card_image != blank %} campaign-card--media{% endif %}" {{ block.shopify_attributes }}>
        {% if card_image != blank %}
          {{ card_image | image_url: width: 1400 | image_tag: class: 'campaign-card__image', widths: '400,600,800,1000,1400', sizes: '(max-width: 749px) 100vw, (max-width: 1100px) 50vw, 34vw', loading: 'lazy' }}
        {% endif %}
        <div class="campaign-card__content">
          {% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
          {% if card_title != blank %}<h3>{{ card_title | escape }}</h3>{% endif %}
          {% if block.settings.text != blank %}<div class="campaign-card__text rte">{{ block.settings.text }}</div>{% endif %}
          {% if card_link != blank and block.settings.button_label != blank %}
            <a class="campaign-card__link" href="{{ card_link }}">{{ block.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{
 "name":"Campaign cards",
 "settings":[
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"DISCOVER"},
 {"type":"text","id":"heading","label":"Heading","default":"Explore beauty"},
 {"type":"select","id":"columns","label":"Desktop columns","options":[{"value":"2","label":"Two"},{"value":"3","label":"Three"}],"default":"3"},
 {"type":"text","id":"view_all_label","label":"View all label","default":"View all"},
 {"type":"url","id":"view_all_link","label":"View all link"}
 ],
 "blocks":[{"type":"campaign","name":"Campaign card","settings":[
 {"type":"collection","id":"collection","label":"Shopify collection"},
 {"type":"product","id":"featured_product","label":"Real product for image"},
 {"type":"image_picker","id":"image","label":"Optional real photo"},
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE EDIT"},
 {"type":"text","id":"heading","label":"Heading (or collection title)"},
 {"type":"richtext","id":"text","label":"Description","default":"<p>Discover your routine.</p>"},
 {"type":"text","id":"button_label","label":"Link text","default":"Explore"},
 {"type":"url","id":"link","label":"Optional link override"}
 ]}],
 "max_blocks":6,
 "presets":[{"name":"Campaign cards","blocks":[{"type":"campaign"},{"type":"campaign"}]}]
}
{% endschema %}
