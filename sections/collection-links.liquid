<section class="site-width section-space" id="CollectionNavigator-{{ section.id }}">
  <div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2></div>
  <div class="collection-grid">
    {% for block in section.blocks %}
      {% if block.settings.collection != blank %}
        {% liquid
          assign tile_collection = block.settings.collection
          assign tile_image = block.settings.image
          if tile_image == blank and block.settings.featured_product != blank and block.settings.featured_product.available
            assign tile_image = block.settings.featured_product.featured_image
          endif
          if tile_image == blank
            for candidate in tile_collection.products limit: 16
              if candidate.available and candidate.featured_image != blank
                assign tile_image = candidate.featured_image
                break
              endif
            endfor
          endif
        %}
        <a class="collection-tile" href="{{ tile_collection.url }}" {{ block.shopify_attributes }}>
          {% if tile_image != blank %}
            {{ tile_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,500,700,900', sizes: '(max-width: 720px) 50vw, 33vw' }}
          {% else %}<div class="collection-tile__empty" aria-hidden="true"></div>{% endif %}
          <h3>{{ tile_collection.title | escape }}</h3>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% schema %}
{
 "name":"Collection navigator",
 "settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by category"}],
 "blocks":[{"type":"collection_item","name":"Collection","settings":[
 {"type":"collection","id":"collection","label":"Collection"},
 {"type":"product","id":"featured_product","label":"Real product for image"},
 {"type":"image_picker","id":"image","label":"Optional real photo"}
 ]}],
 "max_blocks":12,
 "presets":[{"name":"Collection navigator"}]
}
{% endschema %}
