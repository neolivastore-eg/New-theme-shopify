<section class="site-width section-space"><div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2></div><div class="collection-grid">
  {% for block in section.blocks %}{% if block.settings.collection != blank %}
    <a class="collection-tile" href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>
      {% if block.settings.collection.image != blank %}{{ block.settings.collection.image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% endif %}
      <h3>{{ block.settings.collection.title | escape }}</h3>
    </a>{% endif %}{% endfor %}
</div></section>
{% schema %}
{"name":"Collection navigator","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by category"}],"blocks":[{"type":"collection_item","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"}]}],"max_blocks":12,"presets":[{"name":"Collection navigator"}]}
{% endschema %}
