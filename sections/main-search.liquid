<section class="site-width section-space"><h1>{{ 'general.search' | t }}</h1>
  <form action="{{ routes.search_url }}" role="search" method="get" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}" required>
    <input type="hidden" name="type" value="product">
    <button class="button button--primary" type="submit">{{ 'general.search' | t }}</button>
  </form>
  {% if search.performed %}
    {% paginate search.results by 24 %}<div class="product-grid section-space">
      {% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% endif %}{% else %}<p>{{ 'general.no_results' | t }}</p>{% endfor %}
    </div>{% render 'pagination', paginate: paginate %}{% endpaginate %}
  {% endif %}
</section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
