<main class="site-width section-space password-section" id="PasswordMain-{{ section.id }}">
  <p class="eyebrow">{{ shop.name | escape }}</p>
  <h1>{{ section.settings.heading | escape }}</h1>
  {% if shop.password_message != blank %}<div class="rte">{{ shop.password_message }}</div>{% endif %}
  {% form 'storefront_password', class: 'password-form' %}
    {{ form.errors | default_errors }}
    <label for="StorefrontPassword-{{ section.id }}">{{ 'password.label' | t }}</label>
    <input id="StorefrontPassword-{{ section.id }}" type="password" name="password" autocomplete="current-password" required>
    <button type="submit" class="button button--primary">{{ 'password.enter' | t }}</button>
  {% endform %}
</main>
{% schema %}
{"name":"Password page","settings":[{"type":"text","id":"heading","label":"Heading","default":"Coming soon"}]}
{% endschema %}
