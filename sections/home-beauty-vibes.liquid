<section class="nv-vibes nv-surface--white section-space" id="HomeVibes-{{ section.id }}">
  <div class="site-width nv-vibes__inner">
    <p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="nv-serif">{{ section.settings.heading | escape }}</h2>
    <div class="nv-vibes__grid">
      {% for block in section.blocks %}
        {% liquid
          assign photo = block.settings.image
          assign product = block.settings.product
          if photo == blank and product != blank and product.available
            assign photo = product.featured_image
          endif
          if photo == blank and section.settings.collection != blank
            assign offset = forloop.index0
            for candidate in section.settings.collection.products limit: 24 offset: offset
              if candidate.available and candidate.featured_image != blank
                assign photo = candidate.featured_image
                assign product = candidate
                break
              endif
            endfor
          endif
          assign link = block.settings.link
          if link == blank and product != blank and product.available
            assign link = product.url
          endif
        %}
        {% if photo != blank %}
          <div class="nv-vibes__tile" {{ block.shopify_attributes }}>
            {% if link != blank %}<a href="{{ link }}" aria-label="{{ block.settings.label | default: product.title | default: 'Explore beauty' | escape }}">{% endif %}
              {{ photo | image_url: width: 800 | image_tag: widths: '250,400,600,800', sizes: '(max-width:749px) 45vw, 20vw', loading: 'lazy', class: 'nv-vibes__image' }}
            {% if link != blank %}</a>{% endif %}
          </div>
        {% elsif request.design_mode %}
          <div class="nv-media-hint" {{ block.shopify_attributes }}>Select original photo or an available product.</div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
 "name":"Beauty vibes gallery",
 "settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"DISCOVER & SHARE"},
  {"type":"text","id":"heading","label":"Heading","default":"#BeautyVibes"},
  {"type":"collection","id":"collection","label":"Real product image fallback"}
 ],
 "blocks":[{"type":"tile","name":"Real image tile","settings":[
  {"type":"image_picker","id":"image","label":"Original photo"},
  {"type":"product","id":"product","label":"Product photo fallback"},
  {"type":"url","id":"link","label":"Optional destination"},
  {"type":"text","id":"label","label":"Accessible link text"}
 ]}],
 "max_blocks":8,
 "presets":[{"name":"Beauty vibes gallery","blocks":[{"type":"tile"},{"type":"tile"},{"type":"tile"},{"type":"tile"}]}]
}
{% endschema %}
