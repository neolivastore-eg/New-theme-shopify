<section class="nv-voices nv-surface--{{ section.settings.surface }} section-space" id="HomeVoices-{{ section.id }}">
  <div class="site-width nv-voices__inner">
    <p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="nv-serif">{{ section.settings.heading | escape }}</h2>
    {% assign review_count = 0 %}
    <div class="nv-voices__rail">
      {% for block in section.blocks %}
        {% if block.settings.quote != blank and block.settings.name != blank %}
          {% assign review_count = review_count | plus: 1 %}
          <figure class="nv-voices__quote" {{ block.shopify_attributes }}>
            <blockquote>{{ block.settings.quote | escape }}</blockquote>
            <figcaption>— {{ block.settings.name | escape }}</figcaption>
          </figure>
        {% endif %}
      {% endfor %}
    </div>
    {% if review_count == 0 and request.design_mode %}
      <div class="nv-media-hint">Add genuine customer testimonials only. No invented quotes are shown on the storefront.</div>
    {% endif %}
    {% if section.settings.link != blank and section.settings.button_label != blank %}<a class="nv-text-cta" href="{{ section.settings.link }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
  </div>
</section>
{% schema %}
{
 "name":"Customer testimonials",
 "settings":[
  {"type":"select","id":"surface","label":"Background","options":[{"value":"white","label":"White"},{"value":"cream","label":"Warm cream"}],"default":"cream"},
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE NEOLIVA COMMUNITY"},
  {"type":"text","id":"heading","label":"Heading","default":"Your Experience Matters"},
  {"type":"url","id":"link","label":"Optional review page link"},
  {"type":"text","id":"button_label","label":"Link label","default":"Get in touch"}
 ],
 "blocks":[{"type":"quote","name":"Verified customer quote","settings":[
  {"type":"textarea","id":"quote","label":"Genuine customer words"},
  {"type":"text","id":"name","label":"Approved customer name"}
 ]}],
 "max_blocks":8,
 "presets":[{"name":"Customer testimonials"}]
}
{% endschema %}
