<section class="site-width section-space collection-page" id="CollectionMain-{{ section.id }}">
  <header class="page-intro">
    <h1>{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
  </header>
  <form class="catalog-controls" action="{{ collection.url }}" method="get" aria-label="{{ 'catalog.filter_and_sort' | t }}">
    <div class="collection-toolbar">
      <p class="catalog-count">{{ 'catalog.product_count' | t: count: collection.products_count }}</p>
      <label for="CollectionSort-{{ section.id }}">{{ 'collections.sort' | t }}</label>
      <select id="CollectionSort-{{ section.id }}" name="sort_by" data-submit-on-change>
        {% assign sort_value = collection.sort_by | default: collection.default_sort_by %}
        {% for option in collection.sort_options %}
          <option value="{{ option.value | escape }}" {% if option.value == sort_value %}selected{% endif %}>{{ option.name | escape }}</option>
        {% endfor %}
      </select>
    </div>
    {% if collection.filters.size > 0 %}
      <div class="catalog-filters">
        {% for filter in collection.filters %}
          {% if filter.type == 'list' or filter.type == 'boolean' %}
            <details class="catalog-filter">
              <summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
              <div class="catalog-filter__values">
                {% for value in filter.values %}
                  <label class="catalog-filter__value">
                    <input type="checkbox" name="{{ filter.param_name | escape }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                    <span>{{ value.label | escape }} ({{ value.count }})</span>
                  </label>
                {% endfor %}
              </div>
            </details>
          {% endif %}
        {% endfor %}
        <button type="submit" class="button">{{ 'catalog.apply' | t }}</button>
        {% if collection.products_count != collection.all_products_count %}
          <a class="text-link" href="{{ collection.url }}">{{ 'catalog.clear' | t }}</a>
        {% endif %}
      </div>
    {% endif %}
  </form>
  {% paginate collection.products by section.settings.products_per_page %}
    {% if collection.products.size > 0 %}
      <div class="product-grid">{% for item in collection.products %}{% render 'product-card', card_product: item %}{% endfor %}</div>
      {% render 'pagination', paginate: paginate %}
    {% else %}
      <div class="empty-state">
        <p>{{ 'collections.empty' | t }}</p>
        <a class="button" href="{{ collection.url }}">{{ 'catalog.clear' | t }}</a>
      </div>
    {% endif %}
  {% endpaginate %}
</section>
{% schema %}
{"name":"Main collection","settings":[{"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":48,"step":4,"default":24}]}
{% endschema %}
