<section class="nv-newsletter section-space" id="HomeNewsletter-{{ section.id }}">
  <div class="site-width nv-newsletter__inner">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="nv-serif">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.description != blank %}<p class="nv-newsletter__copy">{{ section.settings.description | escape }}</p>{% endif %}
    </div>
    {% form 'customer', class: 'nv-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}
        <p class="nv-newsletter__success" role="status">{{ section.settings.success_text | escape }}</p>
      {% else %}
        <label for="NewsletterEmail-{{ section.id }}">{{ section.settings.label | escape }}</label>
        <div class="nv-newsletter__fields">
          <input type="email" id="NewsletterEmail-{{ section.id }}" name="contact[email]" value="{{ form.email | escape }}" placeholder="Email address" required autocomplete="email" aria-required="true">
          <button type="submit">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></button>
        </div>
        {% if form.errors %}<div class="nv-newsletter__error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      {% endif %}
      {% if section.settings.privacy_text != blank %}<p class="nv-newsletter__privacy">{{ section.settings.privacy_text | escape }}</p>{% endif %}
    {% endform %}
  </div>
</section>
{% schema %}
{
 "name":"Editorial newsletter",
 "settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"FROM NEOLIVA TO YOU"},
  {"type":"text","id":"heading","label":"Heading","default":"A Little Beauty in Your Inbox"},
  {"type":"text","id":"description","label":"Description","default":"Be first to hear about our latest beauty edits and updates."},
  {"type":"text","id":"label","label":"Email field label","default":"Your email address"},
  {"type":"text","id":"button_label","label":"Subscribe button","default":"Subscribe"},
  {"type":"text","id":"success_text","label":"Success message","default":"Thank you for subscribing."},
  {"type":"text","id":"privacy_text","label":"Privacy note","default":"You can unsubscribe at any time."}
 ],
 "presets":[{"name":"Editorial newsletter"}]
}
{% endschema %}
