{% if section.blocks.size > 0 %}
<section class="benefits-section" id="BenefitsSection-{{ section.id }}">
  <div class="site-width benefits-section__inner">
    {% if section.settings.heading != blank %}
      <h2 class="benefits-section__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <ul class="benefits-grid">
      {% for block in section.blocks %}
        <li class="benefits-item" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
          {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
          {% if block.settings.link != blank and block.settings.link_label != blank %}
            <a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Shopping information",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Neoliva experience" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Information item", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery information" },
      { "type": "text", "id": "text", "label": "Description", "default": "Find delivery details at checkout." },
      { "type": "text", "id": "link_label", "label": "Link text", "default": "Learn more" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Shopping information", "blocks": [
      { "type": "benefit", "settings": { "heading": "Delivery", "text": "Check available shipping options." } },
      { "type": "benefit", "settings": { "heading": "Payments", "text": "Payment choices appear at checkout." } },
      { "type": "benefit", "settings": { "heading": "Questions?", "text": "Contact us for product information." } }
    ] }
  ]
}
{% endschema %}
