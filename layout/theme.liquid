<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{% if page_title != blank %}{{ page_title | escape }} · {% endif %}{{ shop.name | escape }}</title>
  {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <style>:root{--bg:{{ settings.color_background }};--surface:{{ settings.color_surface }};--ink:{{ settings.color_text }};--olive:{{ settings.color_accent }};--line:{{ settings.color_border }};--max:{{ settings.page_width }}px}</style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'merchandising.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body>
  <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
</body>
</html>
